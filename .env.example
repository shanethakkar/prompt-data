# Copy to .env and fill in values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# SQLite demo DB path (relative to project root)
DEMO_DB_PATH=data/demo.db

# Default row limit injected into SELECT queries
SQL_DEFAULT_LIMIT=500

# SQL execution timeout in seconds
SQL_TIMEOUT_SECONDS=10

# Log level
LOG_LEVEL=INFO
