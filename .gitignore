# Environment
.env

# Generated data. The slim DB ships gzipped and committed as data/demo.db.gz
# (decompressed at Docker build / via `make unpack-db`); the uncompressed and
# full-fidelity DBs are local-only.
data/demo.db
data/demo.full.db
data/raw/

# Eval outputs: eval_results.json and calibration.json ARE committed (the reproducibility
# artifact, per SPEC Section 11). Only the partial-progress file and rendered charts are ignored.
eval/out/results.partial.jsonl
eval/out/labeled_results.json
eval/out/*.log
eval/out/charts/

